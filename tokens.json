{
  "name": "Desk & Room",
  "theme": "light",
  "color": {
    "bg": "#F6F4EE",
    "surface": "#FFFFFF",
    "text": "#1B2430",
    "text-muted": "#4B5563",
    "accent": "#1B4F8A",
    "focus": "#0B57D0",
    "status-ok": "#146C43",
    "status-stuck": "#B42318",
    "status-idle": "#6B4E00",
    "status-not-started": "#5F6B7A",
    "border": "#6B7280"
  },
  "space": {
    "0": "0px",
    "1": "8px",
    "2": "16px",
    "3": "24px",
    "4": "32px",
    "5": "40px",
    "6": "48px",
    "7": "64px",
    "8": "80px",
    "9": "96px"
  },
  "type": {
    "family": "\"Atkinson Hyperlegible\", \"Noto Sans\", \"DejaVu Sans\", system-ui, sans-serif",
    "size": {
      "xs": "12px",
      "sm": "14px",
      "md": "16px",
      "lg": "20px",
      "xl": "28px",
      "2xl": "40px",
      "3xl": "56px"
    },
    "leading": {
      "tight": 1.15,
      "normal": 1.5,
      "room": 1.4
    },
    "weight": {
      "regular": 400,
      "medium": 600,
      "bold": 700
    }
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "pill": "999px"
  },
  "focus": {
    "width": "3px",
    "offset": "3px"
  },
  "motion": {
    "fast": "120ms",
    "normal": "200ms",
    "slow": "320ms",
    "reduced": "0ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "status": {
    "ok": {
      "color": "status-ok",
      "shape": "circle",
      "label": "On track"
    },
    "stuck": {
      "color": "status-stuck",
      "shape": "triangle",
      "label": "Stuck"
    },
    "idle": {
      "color": "status-idle",
      "shape": "square",
      "label": "Idle"
    },
    "not-started": {
      "color": "status-not-started",
      "shape": "dashed-circle",
      "label": "Not started"
    }
  },
  "modes": {
    "desk": {
      "body_size": "15px",
      "body_line_height": 1.5,
      "min_target": "32px",
      "grid": "8px",
      "max_pupils_visible": 12,
      "large_text": false
    },
    "room": {
      "body_size": "32px",
      "body_line_height": 1.4,
      "min_target": "64px",
      "grid": "8px",
      "max_pupils_visible": 6,
      "large_text": true
    }
  }
}
